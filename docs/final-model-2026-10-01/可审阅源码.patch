+    print(json.dumps({'groups': len(groups), 'rows': sum(map(len, groups.values())), 'csv_sha256': hashlib.sha256(Path(args.csv).read_bytes()).hexdigest(), 'raw_ohlcv_available': False, 'output': args.output}))
